# AssemblyAI Voice Agent API
ASSEMBLYAI_API_KEY=

# Public https address of this server (ngrok), used by Twilio and sheet links
HOSTNAME=

# Twilio, for phone check-ins
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# During development, ring this one verified number instead of each foreman
# MUSTER_PHONE_OVERRIDE=+15551234567

# Google Sheets: path to the service account key JSON
# GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json

# PORT=3000

# Usage limits. MUSTER_PLAN is free, pro or business (defaults to free).
# The plan is read only from the server, so visitors cannot change it.
# MUSTER_PLAN=free
# Optional overrides for a single limit:
# MUSTER_MINUTES_PER_MONTH=30
# MUSTER_CALLS_PER_DAY=20

# Accounts. The first sign up owns the workspace and closes sign up.
# Set to true to let more people create accounts in this same workspace.
# MUSTER_OPEN_SIGNUP=false

# Shown on the Help page as the way to reach you. Unset hides the contact button.
# MUSTER_SUPPORT_EMAIL=you@yourcompany.com

# Sending email, for confirming addresses and password reset links.
# Without both, sending is off and new accounts are created already confirmed.
# MUSTER_RESEND_KEY=re_xxxxxxxx
# MUSTER_MAIL_FROM=Muster <hello@yourdomain.com>
