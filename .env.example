# AssemblyAI Voice Agent API
ASSEMBLYAI_API_KEY=

# Public https address of this server, used by Twilio and sheet links.
# Locally this is your tunnel address; on a host it is the service's own URL.
MUSTER_PUBLIC_URL=

# Older name for the same thing, still read when MUSTER_PUBLIC_URL is unset.
# Prefer MUSTER_PUBLIC_URL: container hosts set HOSTNAME themselves.
# HOSTNAME=

# Twilio, for phone check-ins
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# During development, ring this one verified number instead of each foreman
# MUSTER_PHONE_OVERRIDE=+15551234567

# Google Sheets: path to the service account key JSON
# GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json

# PORT=3000

# Where the JSON store writes. Defaults to ./data next to the project.
# On a host, point this at a disk that survives deploys.
# MUSTER_DATA_DIR=/var/lib/muster

# Usage limits. MUSTER_PLAN is free, pro or business (defaults to free).
# The plan is read only from the server, so visitors cannot change it.
# MUSTER_PLAN=free
# Optional overrides for a single limit:
# MUSTER_MINUTES_PER_MONTH=30
# MUSTER_CALLS_PER_DAY=20

# Accounts. The first sign up owns the workspace and closes sign up.
# Set to true to let more people create accounts in this same workspace.
# MUSTER_OPEN_SIGNUP=false

# Shown on the Help page as the way to reach you. Unset hides the contact button.
# MUSTER_SUPPORT_EMAIL=you@yourcompany.com

# Sending email, for confirming addresses and password reset links.
# Set MUSTER_MAIL_FROM plus one key. Without them, sending is off and new
# accounts are created already confirmed rather than waiting for a link that
# cannot arrive.
#
# Brevo verifies a single sender address, a plain Gmail address is fine, and
# then delivers to anybody. That is what a public sign up needs.
# MUSTER_BREVO_KEY=xkeysib-xxxxxxxx
#
# Resend only delivers to the address that owns the account until a domain you
# own is verified with it.
# MUSTER_RESEND_KEY=re_xxxxxxxx
#
# MUSTER_MAIL_FROM=Muster <you@gmail.com>

# Keeping data on a host with no disk, such as a free instance. The data
# directory is mirrored here after every write and restored at boot.
# Free at upstash.com, no card. Leave unset when the machine has a real disk.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
